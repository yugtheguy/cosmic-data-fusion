# Environment Variables Template

Copy this file to `.env` and update values for your environment.

# ============================================================
# BUNDLED DATA CONFIGURATION (NEW!)
# ============================================================
# Control whether pre-bundled sample datasets can be loaded

# Enable/disable Gaia DR3 sample data loader endpoint
# Set to "false" to hide "Load Gaia Sample" button from UI
COSMIC_ENABLE_GAIA_SAMPLE_LOADER=false

# Enable/disable SDSS DR18 sample data loader endpoint
# Set to "false" to hide "Load SDSS Sample" button from UI
COSMIC_ENABLE_SDSS_SAMPLE_LOADER=false

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# SQLite (Development/Testing) - Default
DATABASE_URL=sqlite:///./cosmic_data_fusion.db

# PostgreSQL with PostGIS (Production) - Recommended
DATABASE_URL=postgresql://cosmic_user:cosmic_secure_pass@localhost:5432/cosmic_data

# PostgreSQL Docker (when using docker-compose)
# DATABASE_URL=postgresql://cosmic_user:cosmic_secure_pass@postgres:5432/cosmic_data

## PostgreSQL Credentials (for docker-compose)
POSTGRES_PASSWORD=cosmic_secure_pass

## Server Configuration
APP_ENV=development
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

## Logging
LOG_LEVEL=INFO

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=securepassword

# Email Configuration
MAIL_USERNAME=deepmehta2006@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=deepmehta2006@gmail.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com

## Optional: Object Storage (MinIO/S3)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=astronomical-data
# MINIO_SECURE=False
